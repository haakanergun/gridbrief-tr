# Live mode is opt-in. Keep false until a protected server deployment is ready.
EPTR_LIVE_ENABLED=false

# Server-only EPİAŞ account values. Never expose these as NEXT_PUBLIC_* values.
EPTR_USERNAME=
EPTR_PASSWORD=

# Protects the live site and API with HTTP Basic authentication.
GRIDBRIEF_ACCESS_USERNAME=
GRIDBRIEF_ACCESS_PASSWORD=

# Optional server-memory data cache lifetime, clamped to 30-900 seconds.
# EPTR_DATA_CACHE_SECONDS=120

# Optional override. Defaults to the Transparency Platform production ticket endpoint.
# EPTR_AUTH_URL=https://giris.epias.com.tr/cas/v1/tickets
